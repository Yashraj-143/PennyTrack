* {\r\n    margin: 0;\r\n    padding: 0;\r\n    box-sizing: border-box;\r\n}\r\n\r\nbody {\r\n    font-family: Arial, sans-serif;\r\n    background: #f5f6f2;\r\n    color: #202820;\r\n}\r\n\r\n.app-container {\r\n    display: flex;\r\n    min-height: 100vh;\r\n}\r\n\r\n.sidebar {\r\n    width: 245px;\r\n    background: #173c30;\r\n    color: white;\r\n    padding: 35px 24px;\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.sidebar h2 {\r\n    font-size: 25px;\r\n}\r\n\r\n.sidebar h2 span {\r\n    color: #a5d6a7;\r\n}\r\n\r\n.tagline, .eyebrow {\r\n    font-size: 11px;\r\n    letter-spacing: 1.5px;\r\n    color: #829a8a;\r\n    margin-top: 10px;\r\n}\r\n\r\n.sidebar nav {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 12px;\r\n    margin-top: 55px;\r\n}\r\n\r\n.sidebar nav a {\r\n    text-decoration: none;\r\n    color: #d0ddd4;\r\n    padding: 13px;\r\n    border-radius: 7px;\r\n}\r\n\r\n.sidebar nav a.active,\r\n.sidebar nav a:hover {\r\n    background: #2b5544;\r\n    color: white;\r\n}\r\n\r\n.sidebar-footer {\r\n    margin-top: auto;\r\n    font-size: 12px;\r\n    color: #b8c9bd;\r\n}\r\n\r\n.main-content {\r\n    flex: 1;\r\n    padding: 45px;\r\n    min-width: 0;\r\n}\r\n\r\n.topbar {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    gap: 20px;\r\n    margin-bottom: 35px;\r\n}\r\n\r\n.topbar h1 {\r\n    font-size: 32px;\r\n    margin: 10px 0;\r\n}\r\n\r\n.topbar button {\r\n    background: #24543e;\r\n    color: white;\r\n    border: none;\r\n    padding: 14px 20px;\r\n    border-radius: 7px;\r\n    cursor: pointer;\r\n}\r\n\r\n.summary-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 20px;\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.summary-card, .panel {\r\n    background: white;\r\n    border: 1px solid #e5e9e2;\r\n    border-radius: 12px;\r\n    padding: 25px;\r\n}\r\n\r\n.summary-card p {\r\n    color: #758075;\r\n    font-size: 14px;\r\n}\r\n\r\n.summary-card h2 {\r\n    font-size: 27px;\r\n    margin: 16px 0 9px;\r\n}\r\n\r\n.summary-card small {\r\n    color: #829082;\r\n}\r\n\r\n.panel {\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.panel h2 {\r\n    margin: 12px 0 20px;\r\n}\r\n\r\n#expenseChart {\r\n    max-height: 260px;\r\n}\r\n\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    text-align: left;\r\n}\r\n\r\nth, td {\r\n    padding: 16px 10px;\r\n    border-bottom: 1px solid #edf0eb;\r\n    font-size: 14px;\r\n}\r\n\r\nth {\r\n    color: #758075;\r\n}\r\n\r\n.positive {\r\n    color: #26834d;\r\n    font-weight: bold;\r\n}\r\n\r\n.negative {\r\n    color: #c15c4c;\r\n    font-weight: bold;\r\n}\r\n\r\n@media (max-width: 750px) {\r\n    .sidebar {\r\n        width: 170px;\r\n        padding: 25px 12px;\r\n    }\r\n\r\n    .main-content {\r\n        padding: 22px 15px;\r\n    }\r\n\r\n    .summary-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n\r\n    .topbar {\r\n        align-items: flex-start;\r\n        flex-direction: column;\r\n    }\r\n\r\n    table {\r\n        font-size: 12px;\r\n    }\r\n\r\n    th, td {\r\n        padding: 12px 5px;\r\n        font-size: 12px;\r\n    }\r\n}\r\n.chart-panel {\r\n    height: 370px;\r\n}\r\n\r\n.chart-panel canvas {\r\n    max-height: 260px;\r\n}\r\n\r\n/* Transaction Modal */\r\n\r\n.modal {\r\n    display: none;\r\n    position: fixed;\r\n    inset: 0;\r\n    background: rgba(0, 0, 0, 0.45);\r\n    justify-content: center;\r\n    align-items: center;\r\n    padding: 20px;\r\n    z-index: 1000;\r\n}\r\n\r\n.modal.show {\r\n    display: flex;\r\n}\r\n\r\n.modal-content {\r\n    background: white;\r\n    width: 100%;\r\n    max-width: 450px;\r\n    padding: 30px;\r\n    border-radius: 14px;\r\n    max-height: 90vh;\r\n    overflow-y: auto;\r\n}\r\n\r\n.modal-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.modal-header h2 {\r\n    margin-top: 8px;\r\n}\r\n\r\n.close-button {\r\n    border: none;\r\n    background: transparent;\r\n    font-size: 28px;\r\n    cursor: pointer;\r\n    color: #555;\r\n}\r\n\r\n#transactionForm {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 10px;\r\n}\r\n\r\n#transactionForm label {\r\n    font-size: 14px;\r\n    font-weight: bold;\r\n    margin-top: 8px;\r\n}\r\n\r\n#transactionForm input,\r\n#transactionForm select {\r\n    width: 100%;\r\n    padding: 12px;\r\n    border: 1px solid #dce3dc;\r\n    border-radius: 7px;\r\n    font-size: 14px;\r\n    background: white;\r\n}\r\n\r\n#transactionForm input:focus,\r\n#transactionForm select:focus {\r\n    outline: 2px solid #39775a;\r\n    border-color: transparent;\r\n}\r\n\r\n.save-button {\r\n    margin-top: 15px;\r\n    padding: 14px;\r\n    background: #24543e;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 7px;\r\n    cursor: pointer;\r\n    font-size: 15px;\r\n}\r\n\r\n.save-button:hover {\r\n    background: #173c30;\r\n}\r\n\r\n.delete-button {\r\n    background: #fff0ed;\r\n    color: #c15c4c;\r\n    border: 1px solid #f2d2cb;\r\n    padding: 7px 12px;\r\n    border-radius: 6px;\r\n    cursor: pointer;\r\n    font-size: 12px;\r\n}\r\n\r\n.delete-button:hover {\r\n    background: #c15c4c;\r\n    color: white;\r\n}\r\n\r\n/* Edit Transaction Button */\r\n\r\n.edit-button {\r\n    background: #eaf2ec;\r\n    color: #24543e;\r\n    border: 1px solid #cdded1;\r\n    padding: 7px 12px;\r\n    border-radius: 6px;\r\n    cursor: pointer;\r\n    font-size: 12px;\r\n    margin-right: 6px;\r\n}\r\n\r\n.edit-button:hover {\r\n    background: #24543e;\r\n    color: white;\r\n}\r\n\r\n/* Transaction Search and Filters */\r\n\r\n.filter-controls {\r\n    display: grid;\r\n    grid-template-columns: 2fr 1fr 1fr;\r\n    gap: 12px;\r\n    margin: 22px 0;\r\n}\r\n\r\n.filter-controls input,\r\n.filter-controls select {\r\n    width: 100%;\r\n    padding: 12px;\r\n    border: 1px solid #dce3dc;\r\n    border-radius: 7px;\r\n    background: white;\r\n    font-size: 13px;\r\n    min-width: 0;\r\n}\r\n\r\n.filter-controls input:focus,\r\n.filter-controls select:focus {\r\n    outline: 2px solid #39775A;\r\n    border-color: transparent;\r\n}\r\n\r\n.empty-message {\r\n    text-align: center;\r\n    color: #829082;\r\n    padding: 25px;\r\n    font-size: 14px;\r\n}\r\n\r\n@media (max-width: 750px) {\r\n    .filter-controls {\r\n        grid-template-columns: 1fr;\r\n    }\r\n}\r\n\r\n/* Monthly Financial Report */\r\n\r\n.report-header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    gap: 15px;\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.report-description {\r\n    color: #829082;\r\n    font-size: 13px;\r\n    margin-top: 8px;\r\n}\r\n\r\n#reportMonth {\r\n    padding: 11px;\r\n    border: 1px solid #dce3dc;\r\n    border-radius: 7px;\r\n    background: white;\r\n    color: #24543e;\r\n}\r\n\r\n.report-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(4, 1fr);\r\n    gap: 15px;\r\n    margin-bottom: 30px;\r\n}\r\n\r\n.report-card {\r\n    background: #f5f7f3;\r\n    padding: 20px;\r\n    border-radius: 9px;\r\n    border: 1px solid #e5e9e2;\r\n}\r\n\r\n.report-card p {\r\n    color: #758075;\r\n    font-size: 13px;\r\n}\r\n\r\n.report-card h3 {\r\n    font-size: 22px;\r\n    margin-top: 12px;\r\n    color: #24543e;\r\n}\r\n\r\n.category-report h3 {\r\n    margin-bottom: 15px;\r\n    font-size: 17px;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n    .report-grid {\r\n        grid-template-columns: repeat(2, 1px);\r\n    }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n    .report-header {\r\n        align-items: flex-start;\r\n        flex-direction: column;\r\n    }\r\n\r\n    .report-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n}\r\n
